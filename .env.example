# Valores para Docker Compose. Las rutas se resuelven dentro del contenedor.
# OAuth de Google: cliente de aplicación web. Ver docs/GOOGLE_SHEETS.md.
APP_GOOGLE_CLIENT_ID=
APP_GOOGLE_CLIENT_SECRET=
APP_GOOGLE_PICKER_API_KEY=
# Número del proyecto de Google Cloud, no su nombre ni ID textual.
APP_GOOGLE_APP_ID=
APP_GOOGLE_REDIRECT_URI=http://localhost:8080/api/sheets/oauth/callback
APP_SHEETS_TIMEOUT_MS=15000
# Presupuesto cooperativo total por PDF, entre 1 y 3600 segundos.
APP_PDF_PROCESSING_BUDGET_SECONDS=300
APP_OCR_SEARCH_BUDGET_SECONDS=8
OCR_CPU_THREADS=4
OCR_ENABLE_MKLDNN=true
